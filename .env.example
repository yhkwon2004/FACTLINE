FACTLINE_STORAGE_MODE=local
APP_URL=http://localhost:3000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ENCRYPTION_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
# Local Python worker uses .venv automatically. No inference API keys.
# LOCAL_PYTHON=C:/path/to/python.exe

# Google Identity Services web client; public identifier, never use an AI API key.
GOOGLE_CLIENT_ID=
# Set false only after Google sign-in is configured and tested.
PASSWORD_LOGIN_ENABLED=true
