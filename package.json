{
  "name": "maze-factline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start -H 127.0.0.1",
    "preview": "next start",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node --test --import tsx src/domain/services/domain-services.test.ts src/application/services/auth-navigation-policy.test.ts src/application/services/auth-service.test.ts src/application/services/memory-integration-service.test.ts src/infrastructure/ai/mock-ai-service.test.ts src/infrastructure/storage/local-storage.test.ts src/domain/services/evidence-graph.test.ts src/infrastructure/security/google-identity.test.ts src/infrastructure/storage/byte-range.test.ts src/domain/services/relationship-graph.test.ts src/domain/services/diagram.test.ts",
    "check:local": "node scripts/check-local.mjs",
    "ai:train": "node scripts/python.mjs train.py",
    "ai:semantic": "node scripts/python.mjs train_semantic.py",
    "ai:check": "node scripts/python.mjs check_media.py",
    "check:cloud-storage": "node --import tsx scripts/check-cloud-vault.ts",
    "ai:relations": "node scripts/python.mjs train_relations.py",
    "ai:check-relations": "node scripts/python.mjs check_relations.py",
    "ai:check-audio": "node scripts/python.mjs check_audio.py",
    "ai:index": "node scripts/python.mjs rebuild_legal_index.py",
    "ai:check-training": "node scripts/python.mjs check_training.py",
    "ai:layout": "node scripts/python.mjs train_layout.py"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.170",
    "@prisma/client": "^5.11.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@vercel/blob": "^2.9.0",
    "ai": "^6.0.168",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.546.0",
    "next": "^16.2.4",
    "prisma": "^5.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "agent-browser": "^0.26.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
